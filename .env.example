# Copy this file to `.env` and fill in your local values.
# Do not commit `.env` — it is gitignored.

# PostgreSQL
DBNAME=motel_data
DBUSER=postgres
DBPASSWORD=your_password
host=localhost
port=5432

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG_MODE=False

# Streamlit -> API
API_BASE_URL=http://127.0.0.1:8000
